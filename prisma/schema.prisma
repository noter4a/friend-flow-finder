generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id        String    @id @default(uuid())
  username  String    @unique
  password  String
  name      String
  role      String    @default("user")
  createdAt DateTime  @default(now())
  clients   Client[]
  sessions  Session[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Client {
  id             String   @id
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  kind           String   @default("cliente")
  email          String?
  phone          String?

  // Dados pessoais
  cpf            String?
  birthDate      String?
  motherName     String?
  rg             String?
  rgIssueDate    String?
  rgIssueState   String?

  // Endereço
  zip            String?
  street         String?
  number         String?
  complement     String?
  district       String?
  city           String?
  state          String?

  // Bancário
  bank           String?
  accountType    String?  @default("corrente")
  agency         String?
  account        String?

  // Financeiro
  totalValue     Float    @default(0)
  percentage     Float    @default(0)
  referrerId     String?

  // Documentos (base64) — LongText para imagens grandes
  docFront       String?  @db.LongText
  docBack        String?  @db.LongText

  notes          String?  @db.Text
  createdAt      DateTime @default(now())
}
